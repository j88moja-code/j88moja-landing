// FibreMate website database: contact messages and demo requests.
// After changing DATABASE_URL to a new database, create the tables with:
//   npx prisma db push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A message from the contact form. The same person may write more than once.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())

  @@index([email])
}

/// A demo request. confirmedAt is set when the person clicks the link in
/// the confirmation email (double opt-in, so fake addresses can't book demos).
model DemoRequest {
  id          Int       @id @default(autoincrement())
  name        String
  email       String
  token       String    @unique
  createdAt   DateTime  @default(now())
  confirmedAt DateTime?

  @@index([email])
}
